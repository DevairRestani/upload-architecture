{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=upload_architecture;Username=postgres;Password=postgres",
    "BlobStorage": "UseDevelopmentStorage=true"
  },
  "BlobStorage": {
    "TempContainerName": "temp",
    "FinalContainerName": "uploads",
    "PublicEndpoint": ""
  },
  "ClamAv": {
    "Host": "localhost",
    "Port": 3310,
    "StreamMaxLengthBytes": 209715200
  },
  "Upload": {
    "AllowedMimeTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    ],
    "AllowedExtensions": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp",
      ".xlsx",
      ".docx"
    ],
    "MaxSizeBytes": 52428800
  },
  "AllowedHosts": "*"
}
